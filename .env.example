# Copy to .env (gitignored) and fill in. scripts/run_api.sh loads .env automatically.
# NEVER commit real values. Everything below is optional: with nothing set, the API runs with
# free/paid gating + admin unlock disabled + Stripe checkout/webhook returning 503.

# Public URL the API is reachable at (used in upgrade_url and Stripe success/cancel URLs).
PUBLIC_BASE_URL=http://127.0.0.1:8080

# SQLite file for accounts/API-key hashes/usage/Stripe ids. Kept separate from the rate DB.
# Docker/Render: /var/data/accounts.sqlite3 on the persistent disk (image default; see DEPLOY.md).
DATABASE_PATH=db/accounts.sqlite3

# Public rate database override (dev/tests only). Default: db/dcc.sqlite3 (Victoria-only, in git).
# Victoria is ALWAYS served from this public DB.
# DCC_DB=
# Operator (paid) rate database with Surrey, copied once onto the persistent disk. Never commit it.
# Docker/Render: /var/data/dcc-operator.sqlite3 (image default). If the file is absent the API serves
# the public build only and paid-only cities (Surrey) answer 404 "not in this build".
# OPERATOR_DB_PATH=
# Private JSON used only by scripts/build_db.py / scripts/ingest.py. Never commit it.
# DCC_SURREY_NORMALIZED=

# ---- Stripe (operator: Kyle's Stripe account) ----
# Secret API key. Use a TEST-mode key (sk_test_...). Enables POST /v1/checkout.
# A live key (sk_live_/rk_live_) is REFUSED unless STRIPE_ALLOW_LIVE=true (Day 5 is test mode only).
STRIPE_SECRET_KEY=
# Leave unset/false until Kyle deliberately goes live.
STRIPE_ALLOW_LIVE=
# Recurring monthly Price IDs created in the Stripe dashboard: Starter $49/mo, Pro $149/mo.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Signing secret of the webhook endpoint pointing at {PUBLIC_BASE_URL}/v1/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=

# ---- Manual / dev only ----
# Long random string. Enables POST /v1/admin/unlock (test purchase without Stripe).
# PRODUCTION: leave EMPTY/UNSET (endpoint then returns 404). Set only temporarily for a manual grant, then remove.   Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_UNLOCK_TOKEN=

# Optional overrides of daily request limits (defaults 50 / 5000 / 50000)
# FREE_DAILY_LIMIT=50
# STARTER_DAILY_LIMIT=5000
# PRO_DAILY_LIMIT=50000
# Max free keys created per client IP per UTC day (default 5). Behind a reverse proxy, run uvicorn with
# --proxy-headers --forwarded-allow-ips=<proxy ip> so the real client IP is used (otherwise all signups share one IP).
# KEY_CREATE_LIMIT_PER_IP=5

# ---- Server (scripts/run_api.sh + Docker image) ----
# PORT=8080
# HOST=127.0.0.1            # run_api.sh only; the Docker image always binds 0.0.0.0
# FORWARDED_ALLOW_IPS=*     # Docker image only; which proxies to trust for X-Forwarded-For (see DEPLOY.md)
