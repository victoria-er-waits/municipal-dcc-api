# Never send secrets or customer data into the build context.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
db/accounts.sqlite3
db/accounts.sqlite3-*
*.accounts.sqlite3

# Paid Surrey inputs never enter the image. The operator rate DB is copied onto the
# persistent disk at runtime (OPERATOR_DB_PATH); see DEPLOY.md.
data/surrey.normalized.json
sources/surrey_*
operator-data/*.sqlite3
operator-data/*.sqlite
operator-data/*.json
*operator*.sqlite3
*operator*.sqlite3-*

# Not needed at runtime
.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
logs
*.log
nohup.out
sources
tests
verification
examples
docs
*.md
!README.md
.DS_Store
