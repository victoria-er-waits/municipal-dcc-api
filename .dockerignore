# Never send secrets or customer data into the build context.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
db/accounts.sqlite3
db/accounts.sqlite3-*
*.accounts.sqlite3

# Paid Surrey inputs. operator-data/dcc.sqlite3 is opt-in via --build-arg OPERATOR_DB
# and is gitignored; it is NOT excluded here so an operator image build can see it.
# Never `docker push` a public tag of an image built with that arg.
data/surrey.normalized.json
sources/surrey_*

# Not needed at runtime
.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
logs
*.log
nohup.out
sources
tests
verification
examples
docs
*.md
!README.md
.DS_Store
